menu = {
    "zians hotdog": 50,
    "chris longganisa": 120,
    "liams meatballs": 35,
    "xavis watermelon": 20,
    "clents lemonade": 15,
    "matheaus chocolate": 10,
    "marions fried chicken": 100
}

accounts = {
    "supercooladmin": {"password": "admin123", "balance": 0, "role": "admin"}
}

orders = []

print("Digital Canteen Ordering System\n")

while True:
    choice = input("\n1. login\n2. exit\n> ")

    if choice == "1":
        username = input("username: ").lower()
        password = input("password: ")

        if username in accounts and accounts[username]["password"] == password:
            print(f"\nlogged in as {username}")

            role = accounts[username]["role"]

            if role == "admin":

                while True:
                    op = input(
                        "1. view menu\n"
                        "2. add/update item\n"
                        "3. remove item\n"
                        "4. create account\n"
                        "5. user management\n"
                        "6. logout\n> "
                    )

                    if op == "1":
                        for item, price in menu.items():
                            print(item, price)

                    elif op == "2":
                        item = input("item name: ").lower()
                        try:
                            price = int(input("price: "))
                            if price >= 0:
                                menu[item] = price
                                print("updated")
                            else:
                                print("invalid price")
                        except:
                            print("invalid price")

                    elif op == "3":
                        item = input("item name: ").lower()
                        if menu.pop(item, None):
                            print("removed")
                        else:
                            print("not found")

                    elif op == "4":
                        new_user = input("new username: ").lower()

                        if new_user in accounts:
                            print("user already exists")
                        else:
                            new_pass = input("password: ")
                            accounts[new_user] = {
                                "password": new_pass,
                                "balance": 0,
                                "role": "user"
                            }
                            print("account created")

                    elif op == "5":
                        target = input("enter username to search: ").lower()

                        if target in accounts:
                            while True:
                                print("\n--- USER ---")
                                print("role:", accounts[target]["role"])
                                print("balance:", accounts[target]["balance"])

                                action = input(
                                    "1. change balance\n"
                                    "2. reset password\n"
                                    "3. view user orders\n"
                                    "4. delete account\n"
                                    "5. back\n> "
                                )

                                if action == "1":
                                    try:
                                        amt = int(input("new balance: "))
                                        if amt >= 0:
                                            accounts[target]["balance"] = amt
                                            print("updated")
                                        else:
                                            print("invalid balance")
                                    except:
                                        print("invalid number")

                                elif action == "2":
                                    new_pass = input("new password: ")
                                    confirm = input("confirm password: ")

                                    if new_pass == confirm:
                                        accounts[target]["password"] = new_pass
                                        print("password reset")
                                    else:
                                        print("not matching")

                                elif action == "3":
                                    user_orders = [o for o in orders if o["user"] == target]

                                    if not user_orders:
                                        print("no orders")
                                    else:
                                        for o in user_orders:
                                            print(o["qty"], "x", o["item"], "=", o["total"])

                                elif action == "4":
                                    confirm = input("delete account? (y/n): ")

                                    if confirm == "y":
                                        del accounts[target]
                                        print("deleted")
                                        break

                                elif action == "5":
                                    break

                                else:
                                    print("not an option")

                        else:
                            print("user not found")

                    elif op == "6":
                        break

                    else:
                        print("not an option")

            else:

                while True:
                    op = input(
                        "1. view menu\n"
                        "2. check balance\n"
                        "3. order\n"
                        "4. logout\n> "
                    )

                    if op == "1":
                        for item, price in menu.items():
                            print(item, price)

                    elif op == "2":
                        print("balance:", accounts[username]["balance"])

                    elif op == "3":
                        cart = []
                        total = 0

                        while True:
                            for item, price in menu.items():
                                print(item, price)

                            order = input("order (done/cancel): ").lower()

                            if order == "done":
                                break
                            elif order == "cancel":
                                cart = []
                                break

                            if order in menu:
                                qty = input("quantity: ")

                                if qty.isdigit():
                                    qty = int(qty)

                                    if qty > 0:
                                        cost = menu[order] * qty
                                        cart.append({
                                            "user": username,
                                            "item": order,
                                            "qty": qty,
                                            "total": cost
                                        })
                                        total += cost
                                        print("added", total)
                                    else:
                                        print("invalid quantity")
                                else:
                                    print("numbers only")
                            else:
                                print("item not found")

                        if cart:
                            if username in accounts and accounts[username]["balance"] >= total:
                                accounts[username]["balance"] -= total
                                orders.extend(cart)
                                print("order confirmed")
                                print("remaining balance:", accounts[username]["balance"])
                            else:
                                print("not enough balance")

                    elif op == "4":
                        break

        else:
            print("wrong login")

    elif choice == "2":
        print("byebye")
        break

    else:
        print("invalid choice")
