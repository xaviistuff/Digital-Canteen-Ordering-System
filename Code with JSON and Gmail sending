                        "2. add/update item\n"
                        "3. remove item\n"
                        "4. create account\n"
                        "5. user management\n"
                        "6. logout\n> "
                    )

                    if op == "1":
                        for i, p in menu.items():
                            print(i, "-", p)

                    elif op == "2":
                        item = input("item: ").lower()
                        price = int(input("price: "))
