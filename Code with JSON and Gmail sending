import json
import os
import smtplib

menu_file = "menu.json"
accounts_file = "accounts.json"
orders_file = "orders.json"

def load(file, default):
    if os.path.exists(file):
        with open(file, "r") as f:
            return json.load(f)
    return default

def save(file, data):
    with open(file, "w") as f:
        json.dump(data, f)

menu = load(menu_file, {
    "zians hotdog": 50,
    "chris longganisa": 120,
    "liams meatballs": 35,
    "xavis watermelon": 20,
    "clents lemonade": 15,
    "matheaus chocolate": 10,
    "marions fried chicken": 100
})

accounts = load(accounts_file, {
    "supercooladmin": {
        "password": "admin123",
        "balance": 0,
        "role": "admin"
    }
})

orders = load(orders_file, [])

def save_all():
    save(menu_file, menu)
    save(accounts_file, accounts)
    save(orders_file, orders)

def send_email(username, cart, total):
    sender_email = "YOUR_EMAIL@gmail.com"
    app_password = "YOUR_APP_PASSWORD"
    receiver_email = "YOUR_EMAIL@gmail.com"

    items_text = ""
    for item in cart:
        items_text += f"{item['qty']}x {item['item']} = {item['total']}\n"

    message = f"""ORDER RECEIPT

User: {username}

ITEMS:
{items_text}

TOTAL: {total}
"""

    text = f"Subject: Order Receipt\n\n{message}"

    server = smtplib.SMTP("smtp.gmail.com", 587)
    server.starttls()
    server.login(sender_email, app_password)
    server.sendmail(sender_email, receiver_email, text.encode("utf-8"))
    server.quit()


