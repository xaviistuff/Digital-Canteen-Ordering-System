                        "1. view menu\n"
                        "2. check balance\n"
                        "3. order\n"
                        "4. change password\n"
                        "5. logout\n> "
                    )

                    if op == "1":
                        for i, p in menu.items():
                            print(i, "-", p)

                    elif op == "2":
                        print("balance:", accounts[username]["balance"])

                    elif op == "3":
                        cart = []
                        total = 0

                        while True:
                            for i, p in menu.items():
                                print(i, "-", p)

                            order = input("item (done to finish): ").lower()

                            if order == "done":
                                break

                            if order in menu:
                                qty = int(input("qty: "))
                                cost = menu[order] * qty

                                cart.append({
                                    "user": username,
                                    "item": order,
                                    "qty": qty,
                                    "total": cost
                                })

                                total += cost

                        if accounts[username]["balance"] >= total:
                            accounts[username]["balance"] -= total
                            orders.extend(cart)
