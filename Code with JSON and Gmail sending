                    elif op == "5":
                        target = input("user: ").lower()

                        if target in accounts:
                            while True:
                                print("\nUSER:", target)
                                print("balance:", accounts[target]["balance"])

                                action = input(
                                    "1. change balance\n"
                                    "2. reset password\n"
                                    "3. view orders\n"
                                    "4. delete account\n"
                                    "5. back\n> "
